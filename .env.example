# Backend credentials, only in server environment (Vercel Settings -> Environment Variables).
# Apps Script Deploy -> Web app -> Copy URL (ends with /exec)
SHEETS_WEB_APP_URL=
# Same randomly generated secret stored as Script Property API_TOKEN.
SHEETS_API_TOKEN=
# Private password for /admin, different from SHEETS_API_TOKEN.
ADMIN_KEY=
EVENT_DATE=2026-10-29
PORT=3001
